# Copy these names into IntelliJ's Run Configuration environment variables.
# This file is a template only. Never commit a real .env file.

PORT=8080
DB_URL=jdbc:mysql://localhost:3306/lecture_archive
DB_USER=root
DB_PASSWORD=replace-with-a-local-only-value
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-characters-long

# Required only when testing email delivery endpoints.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Comma-separated, explicit browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://haru1dh.github.io,http://localhost:5173,http://localhost:63342
